# ── JWT ──────────────────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens.
# Generate a secure value: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_256bit_hex_string

# ── Service-to-service API key ────────────────────────────────────────────────
# Passed by trusted internal services in the X-Api-Key request header
# to access the /users and /users/search endpoints.
# Generate a secure value: openssl rand -hex 32
SERVICE_API_KEY=replace_with_a_random_256bit_hex_string

# ── CORS ─────────────────────────────────────────────────────────────────────
# The exact origin your front-end is served from.
# Example: https://app.example.com
# For local development you can use: http://localhost:3000
CORS_ALLOWED_ORIGIN=https://your-frontend-domain.com

# ── Optional: override config file path ──────────────────────────────────────
# CONFIG_PATH=config.toml
